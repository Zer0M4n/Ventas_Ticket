@page "/"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Ventas_Ticket.Data
@using Ventas_Ticket.Models
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Funcion de Prueba</PageTitle>

<h1>Funcion de Prueba</h1>

@if (evento is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="card" style="max-width: 500px;">
        <div class="card-body">
            <h3 class="card-title">@evento.Nombre</h3>
            <p class="card-text">@evento.Descripcion</p>
            <p><strong>Fecha:</strong> @evento.FechaEvento.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Lugar:</strong> @evento.Lugar</p>
            <p><strong>Precio por boleto:</strong> @evento.Precio.ToString("C")</p>
            <p><strong>Boletos disponibles:</strong> @evento.CupoDisponible</p>

            <AuthorizeView>
                <Authorized>
                    <div class="input-group mb-3" style="max-width: 220px;">
                        <input type="number" min="1" max="@evento.CupoDisponible" class="form-control" @bind="cantidad" />
                        <button class="btn btn-primary" @onclick="Comprar" disabled="@(evento.CupoDisponible < 1)">Comprar</button>
                    </div>
                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <p class="text-success">@mensaje</p>
                    }
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <p class="text-danger">@error</p>
                    }
                </Authorized>
                <NotAuthorized>
                    <p>
                        <a href="Account/Login">Inicia sesion</a> o
                        <a href="Account/Register">registrate</a> para comprar boletos.
                    </p>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
}

@code {
    private Evento? evento;
    private int cantidad = 1;
    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        evento = await Db.Eventos.AsNoTracking().FirstOrDefaultAsync();
    }

    private async Task Comprar()
    {
        mensaje = null;
        error = null;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId is null || evento is null)
        {
            error = "Debes iniciar sesion.";
            return;
        }

        if (cantidad < 1)
        {
            error = "La cantidad debe ser al menos 1.";
            return;
        }

        var eventoDb = await Db.Eventos.FindAsync(evento.Id);

        if (eventoDb is null || eventoDb.CupoDisponible < cantidad)
        {
            error = "No hay suficientes boletos disponibles.";
            evento = await Db.Eventos.AsNoTracking().FirstOrDefaultAsync();
            return;
        }

        eventoDb.CupoDisponible -= cantidad;

        Db.Compras.Add(new Compra
        {
            EventoId = eventoDb.Id,
            UsuarioId = userId,
            Cantidad = cantidad,
            PrecioTotal = eventoDb.Precio * cantidad,
            FechaCompra = DateTime.UtcNow
        });

        await Db.SaveChangesAsync();

        mensaje = $"¡Compra exitosa! Compraste {cantidad} boleto(s).";
        evento = await Db.Eventos.AsNoTracking().FirstOrDefaultAsync();
    }
}
